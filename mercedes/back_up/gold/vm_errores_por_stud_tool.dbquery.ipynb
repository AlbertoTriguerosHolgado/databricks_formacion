   "source": [
    "CREATE MATERIALIZED VIEW mercedes.gold.errores_por_stud_tool AS\n",
    "SELECT\n",
    "    stud_id,\n",
    "    tool,\n",
    "    COUNT(*) AS total_errores\n",
    "FROM mercedes.silver.mensajes\n",
    "WHERE transactiontype = 'MESSAGES'\n",
    "  AND subtype = 'TE1500AC'\n",
    "  AND stud_id IS NOT NULL\n",
    "  AND tool IS NOT NULL\n",
    "GROUP BY stud_id, tool;"
   ]
  }
 ],
